# URL of the backend API server. next.config.js proxies /api/* requests here,
# so the browser never needs to know this value directly.
BACKEND_URL=http://localhost:5000

# Optional: only needed if you call the API directly from the browser
# (bypassing the Next.js rewrite proxy above), e.g. in a static export.
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
